#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LINTER="$ROOT/node_modules/.bin/markdownlint"
FIX=false
ALL=false
FILES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all) ALL=true ;;
    --fix) FIX=true ;;
    --help)
      printf '%s\n' "Usage: scripts/lint [--all] [--fix] [file ...]"
      exit 0
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      exit 2
      ;;
    *) FILES+=("$1") ;;
  esac
  shift
done

if [[ ! -x "$LINTER" ]]; then
  printf '%s\n' "markdownlint-cli is unavailable; run npm install" >&2
  exit 1
fi
ARGS=(--config .markdownlintrc)
if [[ "$FIX" == true ]]; then
  ARGS+=(--fix)
fi


cd "$ROOT"
if [[ ${#FILES[@]} -gt 0 ]]; then
  exec "$LINTER" "${ARGS[@]}" "${FILES[@]}"
fi
if [[ "$ALL" == true ]]; then
  exec "$LINTER" "${ARGS[@]}" '**/*.md' --ignore node_modules
fi

while IFS= read -r file; do
  FILES+=("$file")
done < <(
  {
    git diff --cached --name-only --diff-filter=ACM
    git diff --name-only --diff-filter=ACM
    git ls-files --others --exclude-standard
  } | sort -u
)
MARKDOWN=()
for file in "${FILES[@]}"; do
  [[ "$file" == *.md && -f "$file" ]] && MARKDOWN+=("$file")
done
if [[ ${#MARKDOWN[@]} -eq 0 ]]; then
  printf '%s\n' "No changed Markdown files."
  exit 0
fi
exec "$LINTER" "${ARGS[@]}" "${MARKDOWN[@]}"
